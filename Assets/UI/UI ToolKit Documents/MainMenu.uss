.main-menu-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
    -unity-font-definition: url("project://database/Assets/UI/UI%20Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=b0681a1d8ddede8408995929b41b4d6b&type=3#CinzelDecorative-Bold");
}

.main-menu-left-panel {
    width: 50%;
    min-width: 450px;
    height: 100%;
    padding: 60px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-right-width: 0;
}

.main-menu-title {
    font-size: 72px;
    color: rgb(255, 210, 130);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    margin-bottom: 5px;
    text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
}

.main-menu-subtitle {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-bottom: 35px;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.9);
}

.menu-spacer {
    height: 30px;
}

.menu-button {
    width: 280px;
    height: 65px;
    margin-top: 12px;
    margin-bottom: 12px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Fantasy%20Wooden%20GUI%20%20Free/normal_ui_set%20A/TextBTN_Big.png?fileID=21300000&guid=2be7b70e984b51444aca9c12ae4723a7&type=3#TextBTN_Big");
    -unity-slice-left: 15;
    -unity-slice-right: 15;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
}
